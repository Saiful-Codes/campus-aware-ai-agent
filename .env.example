# Backend environment variables
# Copy this file to backend/.env and replace placeholder values.
# Do NOT commit your real backend/.env file.

# =========================================
# FastAPI Backend
# =========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# =========================================
# Google Gemini API
# =========================================
# The project uses Gemini, NOT OpenAI.
GEMINI_API_KEY=your_gemini_api_key_here

# =========================================
# PostgreSQL + pgvector
# =========================================
# Docker default example values.
# Change them if your local setup uses different ports/users/databases.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_ai
DB_USER=postgres
DB_PASSWORD=postgres

# =========================================
# InfluxDB
# =========================================
# IMPORTANT:
# Docker host port is 18086 (NOT 8086)

INFLUXDB_URL=http://localhost:18086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=campus-ai
INFLUXDB_BUCKET=sensor_data

# =========================================
# Sensor Ingestion Scheduler
# =========================================
# Set SENSOR_SYNC_ENABLED=false during offline work/testing if needed.

SENSOR_SYNC_ENABLED=true
SENSOR_SYNC_INTERVAL_SECONDS=300