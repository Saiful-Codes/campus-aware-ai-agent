# Backend environment variables
# Copy this file to backend/.env and fill in real values.
# Do NOT commit your real backend/.env file.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Google Gemini API (the project uses Gemini, not OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL (pgvector). Both POSTGRES_* and DB_* naming styles are supported.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campus_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_ai
DB_USER=postgres
DB_PASSWORD=postgres

# InfluxDB (note: host port is 18086, not 8086)
INFLUXDB_URL=http://localhost:18086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=campus-ai
INFLUXDB_BUCKET=sensor_data

# Sensor ingestion loop
# Set SENSOR_SYNC_ENABLED=false during tests/offline work.
SENSOR_SYNC_ENABLED=true
SENSOR_SYNC_INTERVAL_SECONDS=300
